# ==============================================================================
# AttendX Backend Environment Variables Configuration
# ==============================================================================

# Web Server Configuration
PORT=5000
HOST=0.0.0.0
FLASK_ENV=development

# Authentication & JWT Security
# Replace with a strong random secret key in production
JWT_SECRET_KEY=attendx_srkr_college_super_secret_jwt_key_2026
TOKEN_EXPIRATION_HOURS=24

# Database Configuration
# SQLite Default:
DATABASE_URL=sqlite:///attendx.db
# PostgreSQL Example:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/attendx_db

# Face Recognition Settings
# InsightFace Model name (default: buffalo_l for SCRFD 10G + ArcFace 512-d)
INSIGHTFACE_MODEL=buffalo_l

# Cosine Similarity Threshold (default: 0.42)
COSINE_SIMILARITY_THRESHOLD=0.42

# Default Admin Bootstrap Credentials
DEFAULT_ADMIN_REG=ADMIN01
DEFAULT_ADMIN_PASS=Admin@123
